# Database Configuration (Railway will provide these)
DB_HOST=${MYSQL_HOST}
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# WordPress Database (configure if needed)
WP_DB_HOST=your_wp_host
WP_DB_NAME=your_wp_database
WP_DB_USER=your_wp_user
WP_DB_PASSWORD=your_wp_password

# Email Configuration (configure your email service)
MAIL_FROM=your_email@yourdomain.com
MAIL_HOST=your_smtp_host
MAIL_USER=your_email_user
MAIL_PASSWORD=your_email_password
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# API Keys (configure your bank APIs)
TFBANK_USERNAME=your_tfbank_username
TFBANK_PASSWORD=your_tfbank_password
INBANK_API_KEY=your_inbank_api_key
EFINANCE_LOGIN=your_efinance_login
EFINANCE_PASS=your_efinance_password

# Security (generate secure keys)
COOKIE_VALIDATION_KEY=generate_secure_key_here
SALT=generate_secure_salt_here

# Application
APP_NAME=FinAI
APP_URL=${RAILWAY_PUBLIC_DOMAIN}
TIMEZONE=Europe/Moscow

# Railway specific
YII_DEBUG=false
YII_ENV=prod
