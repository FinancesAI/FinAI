{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": ["yii2", "framework", "basic", "project template"],
    "homepage": "http://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": ">=2.0.5",
        "yiisoft/yii2-bootstrap": "*",
        "yiisoft/yii2-swiftmailer": "*",
	"himiklab/yii2-sortable-grid-view-widget" : "*",
	"vakorovin/yii2-datetimepicker": "dev-master",
	"philippfrenzel/yii2fullcalendar":"*",
	"google/apiclient":"1.*",
      "ext-curl": "*",
      "ext-json": "*",
        "yiisoft/yii2-httpclient": "*",
        "yiisoft/yii2-queue": "^2.3",
        "giggsey/libphonenumber-for-php": "^8.12",
        "kartik-v/yii2-widget-select2": "@dev",
        "la-haute-societe/yii2-save-relations-behavior": "^1.7",
        "hiqdev/yii2-yandex-metrika": "^0.3.0",
        "kartik-v/yii2-widget-switchinput": "dev-master",
        "bower-asset/angularjs": "^1.7",
        "bower-asset/font-awesome": "^4.7",
        "nesbot/carbon": "^1.3",
        "yiisoft/yii2-bootstrap4": "^2.0",
        "mohorev/yii2-upload-behavior": "*",
        "yiisoft/yii2-imagine": "^2.3",
        "kartik-v/yii2-widget-fileinput": "^1.1",
        "aywan/php-json-canonicalization": "main-dev"
    },
    "require-dev": {
        "yiisoft/yii2-codeception": "*",
        "yiisoft/yii2-debug": "*",
        "yiisoft/yii2-gii": "*",
        "yiisoft/yii2-faker": "*",
        "phpunit/phpunit": "3.7.*"
    },
    "config": {
        "fxp-asset": {
	    "enabled": false
        },
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "kylekatarnls/update-helper": true
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ],
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        },
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    },
   "repositories": [
	{
	 "type": "composer",
	 "url": "https://asset-packagist.org"
	},
     {
       "type": "vcs",
       "url": "https://github.com/aywan/php-json-canonicalization"
     }
	]
}
