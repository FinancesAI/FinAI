# Vercel Environment Variables
# Copy this to .env.local for local development

# Vercel automatically provides these for MySQL:
# MYSQL_HOST
# MYSQL_PORT
# MYSQL_DATABASE
# MYSQL_USER
# MYSQL_PASSWORD

# Application Configuration
YII_ENV=production
YII_DEBUG=false
VERCEL=true

# Security (REQUIRED - Generate new keys!)
COOKIE_VALIDATION_KEY=your_secure_cookie_key_32_chars_min
SALT=your_secure_salt_here

# Email Configuration (Optional)
MAIL_FROM=your_email@yourdomain.com
MAIL_HOST=your_smtp_host
MAIL_USER=your_email_user
MAIL_PASSWORD=your_email_password
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# API Keys (Optional - Configure your bank APIs)
TFBANK_USERNAME=your_tfbank_username
TFBANK_PASSWORD=your_tfbank_password
INBANK_API_KEY=your_inbank_api_key
EFINANCE_LOGIN=your_efinance_login
EFINANCE_PASS=your_efinance_password

# Application Settings
APP_NAME=FinAI
TIMEZONE=Europe/Moscow

# WordPress Database (Optional)
WP_DB_HOST=your_wp_host
WP_DB_NAME=your_wp_database
WP_DB_USER=your_wp_user
WP_DB_PASSWORD=your_wp_password
